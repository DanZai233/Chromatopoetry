# UniLLM configuration
# The in-app settings panel is still the recommended place for personal API keys.
VITE_UNILLM_PROVIDER=gemini
VITE_UNILLM_API_KEY=your_api_key_here
VITE_UNILLM_MODEL=gemini-2.5-flash
# VITE_UNILLM_BASE_URL=

# Legacy fallback: GEMINI_API_KEY is still accepted when VITE_UNILLM_API_KEY is empty.
# GEMINI_API_KEY=your_api_key_here

# Supported providers:
# openai, anthropic, gemini, volcengine, deepseek, moonshot, qwen, zhipu,
# xai, groq, mistral, siliconflow, ollama, custom

# Note: VITE_* values are bundled into the browser build. Use them only for
# local development or restricted keys. User settings stay in localStorage.
